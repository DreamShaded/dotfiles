[Unit]
Description=bge-m3 Embedding Server (infinity-emb, CPU)

[Service]
Type=simple
ExecStart=%h/common/llm/local-brain/embedding-server/bin/infinity_emb v2 \
    --model-id BAAI/bge-m3 \
    --engine torch \
    --port 7997 \
    --device cpu \
    --batch-size 8
Restart=always
RestartSec=5
Environment="HF_HOME=%h/.cache/huggingface"

[Install]
WantedBy=default.target
