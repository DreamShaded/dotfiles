# =====================================================================
# i3 config
# =====================================================================

# ---------------------------------------------------------------------
# База / переменные
# ---------------------------------------------------------------------
set $mod Mod4
set $term qterminal

font pango:Hack 9
floating_modifier $mod

# ---------------------------------------------------------------------
# Запуск приложений (лаунчеры)
# ---------------------------------------------------------------------
bindsym $mod+Return exec $term

# Rofi (режим combi: window + drun + run)
bindsym Ctrl+space exec "rofi -show combi -modi window,drun,run,combi -combi-modi window,drun,run"
bindsym $mod+d exec "rofi -show combi -modi window,drun,run,combi -combi-modi window,drun,run"

# Альтернативы (на всякий)
#bindsym Ctrl+space exec "rofi -show run"
#bindsym Ctrl+space exec dmenu_run

# ---------------------------------------------------------------------
# Окна: закрытие / фокус / перемещение / раскладка
# ---------------------------------------------------------------------
bindsym $mod+Shift+q kill

# Фокус (стрелки)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Перемещение окна (стрелки)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Сплиты
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+t split toggle

# Макет контейнера
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Прочее
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+w sticky toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ---------------------------------------------------------------------
# Рабочие столы
# ---------------------------------------------------------------------
set $ws1 "code"
set $ws2 "web"
set $ws3 "dev"
set $ws4 "msg"
set $ws5 "porn"
set $ws6 "obs"
set $ws7 "7"
set $ws8 "8"
set $ws9 "srv"
set $ws10 "why"

workspace_auto_back_and_forth yes

# Переключение
bindsym F1 workspace $ws1
bindsym F2 workspace $ws2
bindsym F3 workspace $ws3
bindsym F4 workspace $ws4
bindsym F5 workspace $ws5
bindsym F6 workspace $ws6
bindsym F7 workspace $ws7
bindsym F8 workspace $ws8
bindsym F9 workspace $ws9
bindsym F10 workspace $ws10

# Переместить контейнер на рабочий стол
bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8

# Переместить контейнер и сразу перейти
bindsym Shift+F1 move container to workspace $ws1; workspace $ws1
bindsym Shift+F2 move container to workspace $ws2; workspace $ws2
bindsym Shift+F3 move container to workspace $ws3; workspace $ws3
bindsym Shift+F4 move container to workspace $ws4; workspace $ws4
bindsym Shift+F5 move container to workspace $ws5; workspace $ws5
bindsym Shift+F6 move container to workspace $ws6; workspace $ws6
bindsym Shift+F7 move container to workspace $ws7; workspace $ws7
bindsym Shift+F8 move container to workspace $ws8; workspace $ws8
bindsym Shift+F9 move container to workspace $ws9; workspace $ws9
bindsym Shift+F0 move container to workspace $ws10; workspace $ws10

# ---------------------------------------------------------------------
# i3: служебные команды
# ---------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# ---------------------------------------------------------------------
# Режимы
# ---------------------------------------------------------------------
# Изменение размера окна
mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        bindsym j resize shrink width 5 px or 5 ppt
        bindsym k resize grow height 5 px or 5 ppt
        bindsym l resize shrink height 5 px or 5 ppt
        bindsym semicolon resize grow width 5 px or 5 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Быстрое открытие приложений
mode "open" {
        bindsym t exec Telegram; mode "default"
        bindsym a exec anki; mode "default"
        bindsym c exec /home/r/common/bin/cursor/cursor.AppImage; mode "default"
        bindsym Shift+c exec codium; mode "default"
        bindsym f exec thunar; mode "default"
        bindsym z exec zoom; mode "default"
        bindsym v exec virt-manager; mode "default"

        bindsym q exec steam; mode "default"
        bindsym d exec discord; mode "default"
        bindsym g exec google-chrome-stable; mode "default"
        bindsym o exec obsidian; mode "default"

        bindsym Shift+z exec zeal; mode "default"
        bindsym Shift+g exec google-chrome-stable --remote-debugging-port=9222 --user-data-dir=debug; mode "default"

        bindsym Return mode "default"; exec notify-flash "i3" "normal mode"
        bindsym Escape mode "default"; exec notify-flash "i3" "normal mode"
}
bindsym $mod+o mode "open"; exec notify-flash "i3" "mode open"

# ---------------------------------------------------------------------
# Жесты (мышь / swipe)
# ---------------------------------------------------------------------
bindsym --whole-window button19 workspace prev
bindsym --whole-window button17 workspace next

# ---------------------------------------------------------------------
# Мультимедиа
# ---------------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioStop exec playerctl stop

# ---------------------------------------------------------------------
# Скриншоты / буфер / утилиты
# ---------------------------------------------------------------------
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec flameshot full -p ~/Pictures/Screenshots/
bindsym Ctrl+Print exec flameshot full -c

bindsym $mod+Shift+v exec copyq toggle
bindsym $mod+Shift+i exec ~/.local/bin/shcts  # открыть шпаргалку

bindsym $mod+Shift+p exec gnome-calculator
#bindsym $mod+p exec ~/.scripts/dmshot

# Раскладка + блокировка
bindsym $mod+l exec "setxkbmap -layout us && sleep 0.1 && i3lock --blur 5"

# ---------------------------------------------------------------------
# Системный режим (lock/suspend/reboot/…)
# ---------------------------------------------------------------------
set $mode_system (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
bindsym $mod+0 mode "$mode_system"
mode "$mode_system" {
        bindsym l exec --no-startup-id i3exit lock, mode "default"
        bindsym s exec --no-startup-id i3exit suspend, mode "default"
        bindsym u exec --no-startup-id i3exit switch_user, mode "default"
        bindsym e exec --no-startup-id i3exit logout, mode "default"
        bindsym h exec --no-startup-id i3exit hibernate, mode "default"
        bindsym r exec --no-startup-id i3exit reboot, mode "default"
        bindsym Shift+s exec --no-startup-id i3exit shutdown, mode "default"

        bindsym Return mode "default"
        bindsym Escape mode "default"
}

# ---------------------------------------------------------------------
# Режим отключения хоткеев
# ---------------------------------------------------------------------
bindsym F12 mode "unbind"; exec notify-flash "i3" "mode unbind"
mode "unbind" {
        bindsym F12 mode "default"; exec notify-flash "i3" "normal mode"
}

# ---------------------------------------------------------------------
# Внешний вид (цвета клиента)
# ---------------------------------------------------------------------
# class                   border  backgr. text    indicator child_border
client.focused            #000000 #000000 #ffffff #000000   #000000
client.focused_inactive   #000000 #000000 #ffffff #000000   #000000
client.unfocused          #000000 #000000 #888888 #000000   #000000
client.urgent             #000000 #000000 #ffffff #000000   #000000
client.placeholder        #000000 #000000 #ffffff #000000   #000000
client.background         #ffffff

# ---------------------------------------------------------------------
# Правила окон (floating / border / исключения)
# ---------------------------------------------------------------------
for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [class="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [class="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [class="zenity"] floating enable
for_window [class="cachyos-welcome"] floating enable
for_window [instance="copyq"] floating enable, resize set 1000 600, border pixel 5

# ---------------------------------------------------------------------
# Автозапуск
# ---------------------------------------------------------------------

# Языковой переключатель (CapsLock: переключение, Shift+CapsLock: CapsLock)
#exec_always setxkbmap -option grp:caps_toggle "us,ru" -option "grp:caps_toggle,grp_led:caps"

# Монитор(ы)
exec xrandr --output HDMI-1 --mode 1920x1080 --rate 60 --scale 1x1
#exec xrandr --auto --output HDMI-1 --mode 1920x1080 --above HDMI-2

# Обои (per-monitor, конфиг: ~/.config/wallpaper/config)
exec_always --no-startup-id ~/.local/bin/set-wallpaper.sh
exec_always --no-startup-id ~/.local/bin/monitor-hotplug.sh

# Трей/демоны
exec --no-startup-id dunst
exec --no-startup-id picom
exec --no-startup-id copyq
exec --no-startup-id redshift-gtk
exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Отключить dpms/blank/screen saver
exec --no-startup-id xset -dpms
exec --no-startup-id xset s off
exec --no-startup-id xset s noblank

# Полоса громкости (xob)
exec_always mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
#exec ~/.i3/launch.sh

# Polybar (панель)
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Подхват env из профиля (на reload тоже)
exec_always --no-startup-id bash -c "source ~/.profile"
